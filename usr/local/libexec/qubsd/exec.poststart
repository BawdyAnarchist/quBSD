#!/bin/sh

. $2  # Passed by base.conf

CELL=$1
RT_CTX=$D_RUNTM/$CELL/ctx.conf
trap_init

compose_rctl_commands() {
    local _fn="compose_rctl_commands"

    # Establish max memory allocation and jail CPUs
    [ "$MAXMEM" = "none" ] || append _CMDS "rctl -a jail:${CELL}:memoryuse:deny=${MAXMEM}"
    [ "$CPUSET" = "none" ] || append _CMDS "cpuset -j $CELL -cl $CPUSET"
}

compose_flags_commands() {
    local _fn="compose_flags_commands" _dirs _dir _d _cmds_chflags

    # Rootjail file protections can prevent updates, installs, and disrupt appjail starts
    [ "$CLASS" = "rootjail" ] && return 0

    # Different directories are schg flagged depending on user settings
    case $SCHG in
        all) _dirs="/bin /sbin /boot /etc /lib /libexec /root /rw /usr" ;;
        sys) _dirs="/bin /sbin /boot /etc /lib /libexec /rw/etc /rw /usr/bin /usr/lib \
                    /usr/lib32 /usr/libdata /usr/libexec /usr/sbin /usr/local/lib /usr/local/lib32 \
                    /usr/local/libdata /usr/local/libexec /usr/local/sbin"
        ;;
    esac

    # Both native jail directory and /compat/<distro> should receive flags protections
    for _dir in $_dirs ; do
        _d=$R_MNT/$_dir
        [ -e "$_d" ] || continue ;
        append _cmds_chflags "chflags -fR schg $_d"
    done

    for _c in $(hush ls -1 $R_MNT/compat) ; do
        for _dir in $_dirs ; do
            _d=$R_MNT/compat/$_c/$_dir
            [ -e "$_d" ] || continue
            append _cmds_chflags "chflags -fR schg $_d"
        done
    done

    append _CMDS "$(echo "$_cmds_chflags" | sed -E 's|//|/|g')"  # Removes double // directory paths

    # exec.poststart is always sent to background. Don't report seclvl change
    append _CMDS "quiet jexec -l -U root $CELL sysctl kern.securelevel=$SECLVL"
}

main() {
    local _fn="main"

    # bootstrap only needs level 2. Otherwise established runtime might conflict with validation
    mute ctx_load_file $RT_CTX || ctx_bootstrap_runtime -l 2 $CELL || eval $(THROW $?)

    compose_rctl_commands
    compose_flags_commands

    execute_commands "$_CMDS" || eval $(THROW $?)
    return 0
}

main || FATAL
exit 0   # Guarantee that `jail` does not abort startup

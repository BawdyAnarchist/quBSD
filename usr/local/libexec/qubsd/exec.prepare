#!/bin/sh

. $2  # Passed by base.conf

CELL=$1
RT_CTX=$D_RUNTM/$CELL/ctx.conf
trap_init
trap_push "rm -rf $D_RUNTM/$CELL"  # Trap here, because RT_CTX might already exist

resolve_host_context() {
    local _fn="resolve_host_context"
    [ -e "$D_RUNTM/host/ctx.conf" ] && return 0  # Host ctx already exists, do not recreate it
    ctx_bootstrap_runtime -l 3 -p 18 -P $PARAMS_HOST host host_
}

resolve_runtime_context() {
    local _fn="resolve_runtime_context"

    # Load runtime context. 'exec' caller shouldn't exist, if it does, it's stale
    mute ctx_load_file $RT_CTX   # Dont care if it fails, and dont want an $ERR if it fails
    [ "$OWNER" = "exec" ] && rm -f $RT_CTX && unset OWNER

    # If OWNER is empty, then qb isnt coordinating, and `jail` must initialize the runtime context
    if [ -z "$OWNER" ] ; then
        # p_dsets are cloned from rootenv, disps from their template. They might not yet exist
        ctx_bootstrap_runtime -l 3 -p 169,170 $CELL || eval $(THROW $?)
    fi
    return 0
}

compose_prepare_cmds() {
    local _fn="compose_prepare_cmds" _mounts _mounted _CMDS
    unset _CMDS

    # Extra safety mechanism to prevent lingering mounts or cleanup rare kill -9
    [ "$R_MNT" ] && _mounts=$(mount | grep -Eo "$R_MNT/[^[:blank:]]+" | tr '\n' ' ')
    [ "$_mounts" ] && append _CMDS "umount -f $_mounts"

    # If the persist dataset was found (has P_MNT), then make sure its mounted
    if [ "$P_MNT" ] ; then
        _mounted=$(echo_grep "$DATASETS" "$P_DSET" | awk '{print $3}')

        # Handles both mount and encryption password
        if [ ! "$_mounted" = "yes" ] ; then
            is_needpop \
                && append _CMDS "create_popup -c \"zfs mount -l $P_DSET\"" \
                || append _CMDS "zfs mount -l $P_DSET"
        fi
    fi

    # Guarantee basic persistence directories. mkdir is idempotent
    [ "$P_MNT" ] && append _CMDS "hush mkdir -p $P_MNT/$OV $P_MNT/home"

    emit_cmds "$_CMDS"
}

compose_commands() {
    local _fn="compose_commands" _CMDS

    append_compose _CMDS compose_prepare_cmds

    # Only clone/reclone for non-rootjails. Otherwise we'll destroy the rootjail
    if [ ! "$CLASS" = "rootjail" ] ; then
        append_compose _CMDS compose_reclone_root_cmds $CELL || eval $(THROW $?)
    fi

    # Only clone/reclone for dispjails. Otherwise we'll destroy the appjail persistent data
    if [ "$CLASS" = "dispjail" ] ; then
        append_compose _CMDS compose_reclone_persist_cmds $CELL || eval $(THROW $?)
    fi

    emit_cmds "$_CMDS"
}

main() {
    local _fn="main"

    resolve_host_context || eval $(THROW $?)  # Ensure host has a runtime context

    resolve_runtime_context || eval $(THROW $?)

    _COMMANDS=$(compose_commands) || eval $(THROW $?)
    execute_commands "$_COMMANDS" || eval $(THROW $?)

    # Successful completion of all tasks. Keep RT_CTX by removing it from the trap stack
    [ "$OWNER" = "exec" ] && ! echo_grep -q "$DRY_RUN" '(true|TRUE|True)' && trap_pop

    return 0
}

main || FATAL
exit 0   # Guarantee that `jail` does not abort startup

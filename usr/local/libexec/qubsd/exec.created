#!/bin/sh

. $2  # Passed by base.conf

CELL=$1
RT_CTX=$D_RUNTM/$CELL/ctx.conf
trap_init
trap_push "$QLEXEC/exec.release $CELL"   # Cleanup mounts and runtime

# resolvconf defaults to resolv.conf, but this file often has schg flags. Use a symlink instead
compose_resolvconf_cmds() {
    local _r_mnt=$(ctx_get R_MNT)
    _resolv="/var/run/resolvconf/resolv.conf"
    _CMD_LINK_RESOLV="chroot $_r_mnt /bin/sh -c 'ln -sf $_resolv /etc/resolv.conf'"
    _CMD_SET_CONFIG="echo 'resolv_conf=$_resolv' > $_r_mnt/etc/resolvconf.conf"
}

main() {
    local _fn="main"

    # bootstrap only needs level 2. Otherwise established runtime might conflict with validation
    mute ctx_load_file $RT_CTX || eval $(THROW $?)

    # Single unified network construction for CELL, based on its config
    compose_network_construction_cmds $CELL

    # Provide a means for resolvconf to make updates after jail start is complete
    compose_resolvconf_cmds

    _COMMANDS="_CMDS_NETWORK_CONSTRUCTION _CMD_LINK_RESOLV _CMD_SET_CONFIG"
    execute_commands "$_COMMANDS" || eval $(THROW $?)

    trap_pop   # Success. Remove the exec.release trap
    return 0
}

main || FATAL
exit 0   # Guarantee that `jail` does not abort startup


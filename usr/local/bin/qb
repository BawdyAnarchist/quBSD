#!/bin/sh

# Dispatcher script for calling sub-commands

. /usr/local/lib/qubsd/common.sh

main() {
    [ -z "$subcmd" ] && eval $(THROW 1 _generic "qb: ERROR: No command provided")
    case $subcmd in
        help|-h|-H|--h|--help) eval $(THROW 1 usage) ;;
    esac

    if [ -x "$QLEXEC/qb-$subcmd" ] ; then
        shift
        exec "$QLEXEC/qb-$subcmd" "$@"
    else
        eval $(THROW 1 _generic "qb: ERROR: < $subcmd > not found. Use [-h] for command list")
    fi
}

subcmd="$1"
main "$@" || FATAL
